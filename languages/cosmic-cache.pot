msgid "Cosmic Cache preload"
msgstr ""

#: views/page-cache.php
msgid "Enable page cache"
msgstr ""

#: views/page-cache.php
msgid "Master switch. Serves cached pages before WordPress boots."
msgstr ""

#: views/page-cache.php
msgid "Cache lifetime (seconds)"
msgstr ""

#: views/page-cache.php
msgid "How long a cached page stays fresh. After expiry the file is deleted and rebuilt on the next visit. 0 = keep until purged."
msgstr ""

#: views/page-cache.php
msgid "Cache mobile separately"
msgstr ""

#: views/page-cache.php
msgid "Serves a distinct cached page to mobile visitors. Off by default: mobile visitors get the desktop page."
msgstr ""

#: views/page-cache.php
msgid "Cache for logged-in users"
msgstr ""

#: views/page-cache.php
msgid "Caches pages for logged-in users and varies on the auth cookie. Off by default — enabling it means a cached copy per logged-in user."
msgstr ""

#: views/page-cache.php
msgid "Vary on cookies"
msgstr ""

#: views/page-cache.php
msgid "e.g. currency, store_id. Presence of a listed cookie gives those visitors their own cache entries."
msgstr ""

#: views/page-cache.php
msgid "Bypass query params"
msgstr ""

#: views/page-cache.php
msgid "e.g. nocache, preview. These query params force a full cache bypass."
msgstr ""

#: views/page-cache.php
msgid "Whitelisted query params"
msgstr ""

#: views/page-cache.php
msgid "Only these params participate in the cache key; all others are ignored, so /?s=abc and / share one cache entry. Defaults are always included."
msgstr ""

#: views/page-cache.php
msgid "Bypass user agents"
msgstr ""

#: views/page-cache.php
msgid "Requests from these user agents are never cached and never served from cache. One regex or wildcard pattern per line."
msgstr ""

#: views/page-cache.php
msgid "Exclude URLs"
msgstr ""

#: views/page-cache.php
msgid "Never cache these. Plain paths (/cart) or regex patterns (/checkout/.+). One per line."
msgstr ""

#: views/page-cache.php
msgid "Exclude by cookie"
msgstr ""

#: views/page-cache.php
msgid "If a listed cookie is present, the request bypasses the cache. Defaults are always included."
msgstr ""

#: views/page-cache.php
msgid "Precompress gzip"
msgstr ""

#: views/page-cache.php
msgid "Also store a .gz copy, served to clients advertising gzip. Roughly doubles disk usage; falls back to plain HTML."
msgstr ""

#: views/page-cache.php
msgid "Precompress brotli"
msgstr ""

#: views/page-cache.php
msgid "Store .br variants when brotli_compress() is available. Stronger compression than gzip, at a small CPU cost on save."
msgstr ""

#: views/page-cache.php
msgid "Emit HTTP caching headers"
msgstr ""

#: views/page-cache.php
msgid "Send Cache-Control, ETag and Last-Modified on cache hits so browsers and CDNs can cache too."
msgstr ""

#: views/page-cache.php
msgid "Body delivery"
msgstr ""

#: views/page-cache.php
msgid "PHP (universal) streams the file through PHP. X-Sendfile (Apache mod_xsendfile) and X-Accel-Redirect (Nginx) let the web server send the cached file from disk with zero copy — the drop-in still computes the cache key, expiry and encoding, then hands the bytes to the server. The matching module/location must be installed (readme FAQ): otherwise the response has an empty body. Unknown values and paths outside the cache root fall back to PHP (readfile)."
msgstr ""

